# --- Server ---
NODE_ENV=development
PORT=8000

#--- Database ---
MONGODB_URL=https://github.com/ST10220848-Phiwo/hustlehub-POE

# --- CORS ---
# Comma-separated list of allowed origins for the frontend. No wildcard "*"
# once cookies/auth are involved - that combination is rejected by browsers
# for credentialed requests anyway, and is unsafe if it weren't.
CORS_ORIGIN=https://localhost:4000

#--- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

#--- Auth ---
JWT_SECRET= 52f6f7c40b5585074f5abee52e119df0a94edcd683da26391b14feff32704d8c
JWT_EXPIRES_IN=15m